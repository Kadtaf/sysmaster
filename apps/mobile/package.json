{
  "name": "@sysmaster/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src __tests__",
    "test": "jest --ci",
    "bundle": "expo export --platform android --platform ios --output-dir dist-export"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.17",
    "@expo/log-box": "58.0.15",
    "@expo/vector-icons": "15.1.1",
    "@sysmaster/contracts": "workspace:*",
    "expo": "58.0.25",
    "expo-auth-session": "58.0.18",
    "expo-constants": "58.0.16",
    "expo-crypto": "58.0.8",
    "expo-file-system": "58.0.13",
    "expo-linking": "58.0.17",
    "expo-router": "58.0.31",
    "expo-secure-store": "58.0.3",
    "expo-status-bar": "58.0.5",
    "expo-web-browser": "58.0.8",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "^9.26.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": ["<rootDir>/__tests__/**/*.test.ts?(x)"]
  }
}
