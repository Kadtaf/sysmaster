{
  "expo": {
    "name": "SysMaster",
    "slug": "sysmaster",
    "scheme": "sysmaster",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ai.sysmaster.app",
      "supportsTablet": true,
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "ai.sysmaster.app",
      "allowBackup": false
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-web-browser"],
    "experiments": { "typedRoutes": false }
  }
}
