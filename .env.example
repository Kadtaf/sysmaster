# Copier en .env puis adapter. Ne jamais committer de vrais secrets.
POSTGRES_USER=sysmaster
POSTGRES_PASSWORD=sysmaster
POSTGRES_DB=sysmaster
DATABASE_URL=postgres://sysmaster:sysmaster@localhost:5432/sysmaster
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

API_PORT=4000
CORS_ORIGINS=http://localhost:3000

# URL de l'API vue par le navigateur
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# URL de l'API vue par le serveur Next.js (différente dans Docker)
API_URL_INTERNAL=http://localhost:4000/api/v1

# --- Identité (Keycloak) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
# API : émetteur attendu dans les jetons et audience
OIDC_ISSUER=http://localhost:8080/realms/sysmaster
OIDC_AUDIENCE=sysmaster-api
# Facultatif : URL des clés si Keycloak est joint autrement que par l'émetteur (Docker)
# OIDC_JWKS_URL=http://keycloak:8080/realms/sysmaster/protocol/openid-connect/certs

# Web (NextAuth)
NEXTAUTH_URL=http://localhost:3000
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=dev-only-change-me-dev-only-change-me
KEYCLOAK_ISSUER=http://localhost:8080/realms/sysmaster
# KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/realms/sysmaster
KEYCLOAK_CLIENT_ID=sysmaster-web
KEYCLOAK_CLIENT_SECRET=dev-only-web-secret

# Fournisseurs sociaux (lus à l'import du royaume ; voir docs/06-authentification.md)
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID= / MICROSOFT_CLIENT_SECRET=
# GITHUB_CLIENT_ID= / GITHUB_CLIENT_SECRET=

# --- Exploitation ---
# json en production (une ligne JSON par message) ; texte coloré par défaut
# LOG_FORMAT=json
# Métriques Prometheus sur http://localhost:9464/metrics (0 pour désactiver)
METRICS_PORT=9464

# --- Paiement (Stripe) ---
# Sans STRIPE_SECRET_KEY ni STRIPE_WEBHOOK_SECRET, le paiement reste fermé : les offres s'affichent,
# rien ne peut être payé, et le quota IA reste ASSISTANT_DAILY_QUOTA pour tous. Voir docs/08 §Paiement.
# STRIPE_SECRET_KEY=sk_test_…
# STRIPE_WEBHOOK_SECRET=whsec_…
# STRIPE_PRICES=premium:price_…,pro:price_…
# STRIPE_AUTOMATIC_TAX=false
# Adresse du site pour les retours de paiement (par défaut, la première de CORS_ORIGINS).
# PUBLIC_WEB_URL=http://localhost:3000

# --- Assistant IA (Phase 3, services/ai) ---
# API cœur → service IA. Le jeton partagé prouve que l'appel vient du cœur (openssl rand -hex 32 en production).
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=dev-only-ai-token
# AI_SERVICE_TIMEOUT_MS=90000
# Génération d’un lab complet par l’IA (deux appels au plus) :
# AI_LAB_TIMEOUT_MS=240000
# Questions par utilisateur et par 24 h (×3 auteurs et relecteurs, ×10 administrateurs)
ASSISTANT_DAILY_QUOTA=30
# Service IA : « fake » (gratuit, réponses factices) ou « claude » (exige ANTHROPIC_API_KEY)
AI_LLM=fake
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
# ANTHROPIC_API_KEY=
CORE_API_URL=http://localhost:4000/api/v1
# Documentation officielle (RAG) : le service IA utilise QDRANT_URL ci-dessus (vide pour s'en passer).
# Remplir l'index : cd services/ai && uv run python -m app.rag.ingest --max-pages 50
# « fastembed » : modèle multilingue local (extra du même nom, inclus dans l'image) ; « hash » : tests
# AI_EMBEDDER=hash
