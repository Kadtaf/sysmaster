{
  "name": "sysmaster",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "node infra/scripts/migrate.mjs",
    "db:seed": "node infra/scripts/migrate.mjs --seed",
    "db:reset": "node infra/scripts/migrate.mjs --reset --seed"
  },
  "devDependencies": {
    "pg": "^8.13.1",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23"
    }
  }
}
